# Copy to .env (gitignored). Never commit real values.
# data.gov.in personal API key for CPCB real-time AQI (resource 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69)
DATAGOV_KEY=
# AWS profile for cloud mode and the real Bedrock agent. Leave empty for local-only mode.
AWS_PROFILE=
AWS_REGION=ap-south-1
# Demo passcodes (local mode only; cloud reads them from SSM Parameter Store)
KHIDKI_TEACHER_PASSCODE=
KHIDKI_PRINCIPAL_PASSCODE=
KHIDKI_ADMIN_PASSCODE=
# Where alarm emails and the 1 USD spend-guard budget alerts go (cloud deploys only)
KHIDKI_ALERT_EMAIL=
